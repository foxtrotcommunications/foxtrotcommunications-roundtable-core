# ─── Server ───────────────────────────────────────────
PORT=3000
SESSION_SECRET=change-me-to-a-random-string

# Purpose-specific secrets (recommended — falls back to SESSION_SECRET if not set)
# SSO_JWT_SECRET=           # Signs/verifies SSO tokens from the control plane
# BRIDGE_HMAC_SECRET=       # Signs/verifies bridge and webhook HMAC signatures

# ─── Workspace Identity ──────────────────────────────
# Each container is a workspace. Set a unique ID per deployment.
WORKSPACE_ID=dev
WORKSPACE_NAME=Development
# WORKSPACE_URL=http://localhost:3000  # Required for cross-workspace messaging
# PLATFORM_ORG=Your Company Name      # Appears in AI system prompt and describe_workspace

# ─── Database (PostgreSQL required) ──────────────────
# Local:     postgresql://localhost:5432/roundtable
# Cloud SQL: postgresql://user:pass@/roundtable?host=/cloudsql/project:region:instance
# GKE:       postgresql://user:pass@127.0.0.1:5432/roundtable  (via Cloud SQL proxy sidecar)
DATABASE_URL=postgresql://localhost:5432/roundtable

# ─── AI Provider Keys (optional server-level defaults) ─
# Users can also configure their own keys in the app.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=

# ─── Embed Mode ───────────────────────────────────────
# Set to "true" to allow iframe embedding (e.g. inside Anvil)
EMBED_MODE=false
EMBED_ALLOWED_ORIGINS=

# ─── Demo Mode ────────────────────────────────────────
# Set to "true" to enable auto-login guest accounts
DEMO_MODE=false

# ─── Vertex AI (uses gcloud ADC — no API key needed) ──
GCP_PROJECT=
GCP_LOCATION=us-central1

# ── Ollama / OpenAI-Compatible Endpoint ──────────
# Default Ollama host (can be overridden per-workspace in Settings)
# OLLAMA_HOST=http://localhost:11434

# ─── Google Custom Search (for web_search tool) ───────
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# ─── Security ─────────────────────────────────────────
# Set to "false" to disable shell_exec tool entirely
# SHELL_EXEC_ENABLED=true
# Set to "false" to allow HTTP-only cookies (default: true in production)
# SECURE_COOKIES=false

# Required in production. 64-char hex string for AES-256-GCM API key encryption.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# API_KEY_ENCRYPTION_KEY=

# Session idle timeout in minutes (default: 30). Set higher for development.
# SESSION_IDLE_MINUTES=30

# Restrict which AI providers this workspace can use (JSON array, default: all)
# Example: '["vertexai"]' — enforces Vertex AI only (blocks PHI from external APIs)
# ALLOWED_PROVIDERS=

# ─── BigQuery (uses same ADC as Vertex AI) ────────────
# Automatically available when GCP_PROJECT is set.
# BQ_PROJECT=your-project       # Override: query a different project
# BQ_LOCATION=us-central1       # Override: BigQuery region
# BQ_MAX_BYTES=1073741824       # Override: max bytes scanned per query (default 1GB)

# ─── Snowflake ────────────────────────────────────────
# SNOWFLAKE_ACCOUNT=abc12345.us-east-1
# SNOWFLAKE_USERNAME=roundtable
# SNOWFLAKE_PASSWORD=your-password
# SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# SNOWFLAKE_DATABASE=ANALYTICS
# SNOWFLAKE_SCHEMA=OMOP
# SNOWFLAKE_ROLE=ANALYST

# ─── Databricks SQL ──────────────────────────────────
# DATABRICKS_HOST=adb-1234567890.12.azuredatabricks.net
# DATABRICKS_TOKEN=dapi-your-token
# DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123
# DATABRICKS_CATALOG=main
# DATABRICKS_SCHEMA=omop

# ─── Protocol Integrations ───────────────────────────
# MCP Server — expose workspace tools via Model Context Protocol
# MCP_SERVER_ENABLED=true
# MCP_API_KEY=your-mcp-api-key     # Required: authenticates MCP client connections

# A2A Server — expose workspace as an Agent-to-Agent protocol agent
# A2A_SERVER_ENABLED=true
# A2A_API_KEY=your-a2a-api-key     # Required: authenticates A2A client connections
