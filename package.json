{
  "name": "roundtable",
  "version": "1.1.0",
  "description": "Real-time multiplayer AI chat sharing platform — collaborate on AI conversations together",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "test": "node -e \"const v=parseInt(process.version.slice(1)); const args = v>=25 ? ['--localstorage-file=/tmp/roundtable-test-ls'] : []; const cp = require('child_process').spawnSync('node', [...args, './node_modules/.bin/jest', '--verbose'], {stdio:'inherit'}); process.exit(cp.status)\"",
    "test:watch": "node -e \"const v=parseInt(process.version.slice(1)); const args = v>=25 ? ['--localstorage-file=/tmp/roundtable-test-ls'] : []; const cp = require('child_process').spawnSync('node', [...args, './node_modules/.bin/jest', '--watch'], {stdio:'inherit'}); process.exit(cp.status)\"",
    "migrate": "node-pg-migrate --database-url-var DATABASE_URL --migrations-dir migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "typecheck": "tsc --noEmit -p server/tsconfig.json",
    "dev:ts": "tsx watch server/index.js",
    "test:e2e": "playwright test"
  },
  "keywords": [
    "ai",
    "chat",
    "multiplayer",
    "collaborative",
    "real-time",
    "openai",
    "anthropic",
    "gemini",
    "socket.io"
  ],
  "author": "Foxtrot Communications",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/foxtrotcommunications/foxtrotcommunications-roundtable-core.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@a2a-js/sdk": "^0.3.13",
    "@databricks/sql": "^1.14.0",
    "@google-cloud/bigquery": "^8.3.1",
    "@google/genai": "^2.2.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.1",
    "express-rate-limit": "^8.5.1",
    "express-session": "^1.18.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.10.1",
    "mathjs": "^15.2.0",
    "multer": "^2.1.1",
    "node-fetch": "^2.7.0",
    "node-pg-migrate": "^8.0.4",
    "pg": "^8.20.0",
    "snowflake-sdk": "^2.4.1",
    "socket.io": "^4.8.1",
    "zod": "^4.4.3"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.9.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.15.0",
    "@types/node-fetch": "^2.6.13",
    "@types/pg": "^8.11.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "ts-jest": "^29.4.11",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
